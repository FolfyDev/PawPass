# ---- Core ----
PUBLIC_URL=http://localhost:4000          # where the API is reachable from the internet
WEB_URL=http://localhost:8080             # where the front end is reachable
SERVER_PORT=4000
WEB_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
# IANA zone new events start with, e.g. America/New_York, America/Los_Angeles,
# Europe/London. The server itself always runs in UTC — this only seeds each
# new event's own timezone field, which you can still change per event.
DEFAULT_TIMEZONE=America/New_York

# ---- Database ----
POSTGRES_USER=pawpass
POSTGRES_PASSWORD=pawpass
POSTGRES_DB=pawpass

# ---- Telegram ----
# Create a bot with @BotFather and paste the token here.
# /setdomain is ONLY needed for the blue "Log in with Telegram" button, and it
# only accepts a public https domain. For local testing, skip it and use the
# bot's /login command to get a sign-in code instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
LOGIN_CODE_TTL_MINUTES=10

# ---- Local development ----
# Adds a "Dev" tab on the sign-in page that creates a throwaway account with
# any role, so you can click through the whole app with no bot at all.
# Ignored unless PUBLIC_URL is plain http on localhost.
DEV_AUTH=false

# ---- First owner account (created on first boot) ----
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=change-me
OWNER_TELEGRAM_ID=

# ---- Email (optional, for mass mail) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Con Registration <noreply@example.com>"

# ---- Badge printer (Zebra ZD500) ----
ZEBRA_HOST=192.168.1.50
ZEBRA_PORT=9100
ZEBRA_DPI=300                              # ZD500 is 203 or 300 dpi depending on model

# ---- Apple Wallet (optional) ----
# Drop your certs in ./certs
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_CERT=/app/certs/wwdr.pem
APPLE_SIGNER_CERT=/app/certs/signerCert.pem
APPLE_SIGNER_KEY=/app/certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=

# ---- Google Wallet (optional) ----
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=/app/certs/google-wallet.json
