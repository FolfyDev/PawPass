generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  /// Holds a seat while the attendee is on Stripe Checkout. Becomes CONFIRMED
  /// from the webhook once Stripe says the session is paid, or CANCELLED when
  /// the session expires (see lib/payments.js).
  PENDING_PAYMENT
}

enum RsvpStatus {
  YES
  MAYBE
  NO
}

enum PaymentMethod {
  CASH
  CARD
  PAYPAL
  /// Online, via Stripe Checkout. Only ever set by lib/payments.js from a
  /// Stripe-verified session, never by staff.
  STRIPE
  OTHER
}

/// What happens when an attendee cancels a ticket they paid for. Free and
/// unpaid tickets can always be cancelled directly.
enum CancelPolicy {
  /// They cancel and get refunded straight away (Stripe payments go back to
  /// the card automatically).
  AUTO_REFUND
  /// They ask to cancel; an owner approves (which refunds) or declines.
  REQUEST
}

enum MerchOrderStatus {
  /// Stock is held while the buyer is on Stripe Checkout.
  PENDING
  PAID
  /// Checkout expired or failed; the held stock went back.
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// A person. Attendees always arrive through Telegram; staff may also hold a password.
model User {
  id               String         @id @default(cuid())
  telegramId       String?        @unique
  telegramUsername String?
  telegramPhotoUrl String?
  displayName      String
  /// Encrypted at rest (see lib/crypto.js). Never queried directly, so no
  /// blind index is needed here (compare Registration.legalName below).
  legalName        String?
  fursonaName      String?
  /// Encrypted at rest; emailIndex carries the @unique constraint instead of
  /// the column itself, since encryption uses a random IV per value and the
  /// same address never encrypts to the same ciphertext twice.
  email            String?
  emailIndex       String?        @unique
  passwordHash     String?        // staff only — attendees never get one
  role             Role           @default(USER)
  /// Bumped on logout or password change; a JWT's embedded `ver` claim must
  /// match this or loadUser() treats the request as signed out. Lets a
  /// logout invalidate the token everywhere, not just clear this browser's
  /// cookie — see issueToken()/loadUser() in lib/auth.js.
  tokenVersion     Int            @default(0)
  createdAt        DateTime       @default(now())

  registrations    Registration[]
  checkIns         Registration[] @relation("CheckedInBy")
  auditEntries     AuditLog[]
  sales            Sale[]         @relation("SalesProcessedBy")
  donationsProcessed Donation[]   @relation("DonationsProcessedBy")
  paymentsProcessed Payment[]     @relation("PaymentsProcessedBy")
  merchOrders      MerchOrder[]
  merchPickups     MerchOrder[]   @relation("MerchPickedUpBy")
  bansCreated      Ban[]          @relation("BansCreatedBy")
}

model Event {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  tagline          String?
  description      String         @default("")
  venue            String?
  startsAt         DateTime
  endsAt           DateTime
  timezone         String         @default("America/New_York")
  capacity         Int?           // null = unlimited
  waitlistEnabled  Boolean        @default(true)
  opensAt          DateTime?
  closesAt         DateTime?
  published        Boolean        @default(false)
  tosTitle         String         @default("Code of Conduct & Terms")
  tosBody          String         @default("")
  /// Extra questions, rendered on web and asked by the bot.
  /// [{ key, label, type: text|select|checkbox|number, required, options[], help }]
  customFields     Json           @default("[]")
  badgeTemplateId  String?
  badgeTemplate    BadgeTemplate? @relation(fields: [badgeTemplateId], references: [id])
  accentColor      String         @default("#FF5B04")
  cancelPolicy     CancelPolicy   @default(REQUEST)
  /// Optional "add a donation" step at online checkout, on top of the ticket.
  /// Charged as its own line on the same Stripe session.
  donationAddonEnabled Boolean    @default(false)
  donationAddonLabel   String     @default("Add a donation")
  /// Preset amounts in cents; attendees can also type their own.
  donationAddonPresets Int[]      @default([500, 1000, 2500])
  /// Atomically incremented to hand out sequential badge numbers.
  nextBadgeNumber  Int            @default(1)
  createdAt        DateTime       @default(now())

  registrations    Registration[]
  ticketTiers      TicketTier[]
  discountCodes    DiscountCode[]
  merchOrders      MerchOrder[]
  campaigns        EmailCampaign[]
  merchItems       MerchItem[]
  voucherCodes     VoucherCode[]
  donations        Donation[]
}

model Registration {
  id            String             @id @default(cuid())
  /// Human-readable, printed on the badge. e.g. "RL7-4KQ2"
  code          String             @unique
  /// Opaque secret embedded in the QR so codes can't be guessed.
  secret        String             @unique
  eventId       String
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// legalName, fursonaName, email, and answers are all encrypted at rest
  /// (see lib/crypto.js). legalNameIndex/emailIndex are blind indexes (HMAC
  /// of the lowercased, trimmed value) that stand in for the encrypted
  /// column wherever the app needs an exact-match lookup, e.g. the
  /// duplicate-registration check in findOrCreateHeadlessUser — the
  /// encrypted column itself can't be filtered, sorted, or matched by
  /// substring at the DB level, since encryption uses a random IV per value.
  legalName     String
  legalNameIndex String?
  fursonaName   String
  email         String?
  emailIndex    String?
  /// Encrypted JSON (stringified before encryption, parsed back on read) —
  /// custom-question answers are free text and can contain anything.
  answers       String             @default("")
  status        RegistrationStatus @default(CONFIRMED)
  /// null for voucher redemptions, which bypass tiers entirely.
  ticketTierId  String?
  ticketTier    TicketTier?        @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  /// Denormalized copy of the tier's name at registration time, so the badge
  /// keeps printing it even if the tier is later renamed or deleted — same
  /// reasoning as badgeTier below.
  tierName      String?
  /// Discount applied to the ticket price, in cents, and the code it came
  /// from. Snapshotted, so editing the code later doesn't change what this
  /// registration owes.
  discountCodeId String?
  discountCode  DiscountCode?      @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountCents Int                @default(0)
  /// Donation add-on the attendee chose, in cents — reused if they retry checkout.
  donationCents Int                @default(0)
  /// Set while a cancellation request (Event.cancelPolicy REQUEST) waits on
  /// an owner; cleared when it's approved or declined.
  cancelRequestedAt DateTime?
  cancelRequestNote String?
  /// Assigned once the registration holds a confirmed or waitlisted spot —
  /// never while PENDING_PAYMENT, so abandoned checkouts don't burn numbers.
  badgeNumber   Int?
  rsvp          RsvpStatus         @default(YES)
  source        String             @default("web") // web | telegram | admin
  payments      Payment[]

  voucherCodeId String?
  voucher       VoucherCode?       @relation(fields: [voucherCodeId], references: [id], onDelete: SetNull)
  /// Denormalized copy of the voucher's badgeTier at redemption time, so the
  /// badge keeps showing it even if the voucher is later edited or deleted.
  badgeTier     String?

  tosAcceptedAt DateTime?
  tosVersion    String?
  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?              @relation("CheckedInBy", fields: [checkedInById], references: [id])
  badgePrintedAt DateTime?
  printCount    Int                @default(0)
  createdAt     DateTime           @default(now())

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([ticketTierId])
  @@index([legalNameIndex])
  @@index([emailIndex])
}

/// A purchasable (or free) ticket type for an event, e.g. "Attendee",
/// "Sponsor", "Early bird". PawPass is the source of truth; each paid tier is
/// pushed to Stripe as a Product + Price (see lib/stripe.js syncTier).
model TicketTier {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  description     String         @default("")
  /// Integer cents. 0 = free.
  priceCents      Int            @default(0)
  currency        String         @default("usd")
  /// Per-tier limit on top of the event's own capacity; null = no tier limit.
  /// Counts CONFIRMED + PENDING_PAYMENT, same as the event capacity does.
  capacity        Int?
  sortOrder       Int            @default(0)
  /// Optional sale window. Outside it the tier shows but can't be bought.
  salesStartAt    DateTime?
  salesEndAt      DateTime?
  /// Inactive tiers are hidden from sale but kept, so existing registrations
  /// still point at them. Tiers with registrations can't be deleted.
  active          Boolean        @default(true)
  stripeProductId String?        @unique
  stripePriceId   String?
  stripeSyncedAt  DateTime?
  /// Last sync failure, shown to staff; cleared on the next successful sync.
  stripeSyncError String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  registrations   Registration[]

  @@index([eventId])
}

/// Money received for a registration — either a Stripe Checkout attempt, or
/// an in-person payment staff recorded at the kiosk/attendee editor. No card
/// data is ever stored; Stripe rows only hold Stripe's own IDs.
model Payment {
  id                    String        @id @default(cuid())
  /// Exactly one of registrationId / merchOrderId is set.
  registrationId        String?
  registration          Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  merchOrderId          String?
  merchOrder            MerchOrder?   @relation(fields: [merchOrderId], references: [id], onDelete: Cascade)
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  /// Integer cents.
  amountCents           Int
  amountRefundedCents   Int           @default(0)
  /// Part of amountCents that was the donation add-on, for reporting.
  donationCents         Int           @default(0)
  /// Stripe's processing fee and what actually lands in the account, from
  /// the charge's balance transaction. Null until fetched (or not Stripe).
  feeCents              Int?
  netCents              Int?
  currency              String        @default("usd")
  note                  String?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  /// When the Stripe Checkout session (and so the held seat) lapses.
  expiresAt             DateTime?
  paidAt                DateTime?
  /// Staff member who recorded an in-person payment; null for Stripe.
  processedById         String?
  processedBy           User?         @relation("PaymentsProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([registrationId])
  @@index([merchOrderId])
  @@index([status, expiresAt])
}

/// A percent- or amount-off code for ticket tiers, applied by PawPass before
/// checkout (not a Stripe coupon, so the charged amount is always exactly
/// what PawPass computed).
model DiscountCode {
  id             String         @id @default(cuid())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code           String
  /// Exactly one of percentOff (1-100) / amountOffCents is set.
  percentOff     Int?
  amountOffCents Int?
  /// null = unlimited. usedCount is claimed with a compare-and-swap, and
  /// given back if a checkout hold lapses unpaid.
  maxUses        Int?
  usedCount      Int            @default(0)
  /// Tier IDs it applies to; empty = every tier.
  tierIds        String[]       @default([])
  active         Boolean        @default(true)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  registrations  Registration[]

  @@unique([eventId, code])
}

/// An online merch pre-order, picked up at the event.
model MerchOrder {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        MerchOrderStatus @default(PENDING)
  totalCents    Int
  currency      String           @default("usd")
  pickedUpAt    DateTime?
  pickedUpById  String?
  pickedUpBy    User?            @relation("MerchPickedUpBy", fields: [pickedUpById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items         MerchOrderItem[]
  payments      Payment[]

  @@index([eventId, status])
  @@index([userId])
}

model MerchOrderItem {
  id             String     @id @default(cuid())
  orderId        String
  order          MerchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId         String
  item           MerchItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Snapshots, so a later price or name change doesn't rewrite the order.
  name           String
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
}

/// Stripe webhook event IDs already applied. Stripe retries deliveries and
/// can send the same event more than once; inserting here inside the same
/// transaction as the update makes a duplicate a no-op.
model StripeEvent {
  id          String   @id // evt_...
  type        String
  processedAt DateTime @default(now())
}

/// Everything about how a badge looks lives here as data, so it is editable in the UI.
model BadgeTemplate {
  id        String   @id @default(cuid())
  name      String
  widthMm   Float    @default(85.6)
  heightMm  Float    @default(54)
  dpi       Int      @default(300)
  background String  @default("#0E1116")
  /// [{ id, type: text|qr|image|rect|line, x, y, w, h, ... }] — mm units, top-left origin
  elements  Json     @default("[]")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  events    Event[]
}

model EmailCampaign {
  id          String   @id @default(cuid())
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  subject     String
  body        String   // supports {{fursona_name}} {{legal_name}} {{code}} {{event_title}}
  audience    String   @default("all") // all | checked_in | not_checked_in | waitlist
  sentAt      DateTime?
  sentCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

/// A merch/inventory item sold at an event's table, e.g. a shirt or a print.
/// Scoped per event, like registrations and campaigns.
model MerchItem {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  price     Float?
  maxCount  Int
  /// Atomically incremented on each sale via a compare-and-swap update, so
  /// concurrent sales at the table can never oversell past maxCount.
  soldCount Int      @default(0)
  /// Can be pre-ordered online through Stripe (needs a price and Stripe set up).
  preorder  Boolean  @default(false)
  createdAt DateTime @default(now())

  sales     Sale[]
  orderItems MerchOrderItem[]

  @@index([eventId])
}

/// One recorded merch sale. Attributed to the staff member who processed it,
/// not the buyer — there's no attendee lookup at the merch table.
model Sale {
  id            String        @id @default(cuid())
  itemId        String
  item          MerchItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity      Int           @default(1)
  paymentMethod PaymentMethod
  paymentNote   String?
  processedById String
  processedBy   User          @relation("SalesProcessedBy", fields: [processedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([itemId])
}

/// A cash/card/etc. donation taken in person at the table — not tied to any
/// merch item or event registration, e.g. a walk-up donation box. Recorded
/// from the Merch tab (where staff are already handling in-person payments)
/// and rolled into the Cash reconciliation totals alongside ticket
/// payments and merch sales.
model Donation {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod PaymentMethod
  note          String?
  processedById String
  processedBy   User          @relation("DonationsProcessedBy", fields: [processedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([eventId])
}

/// A code that grants a free, guaranteed-confirmed registration tagged with a
/// custom badge label — e.g. "Organizer", "Photographer" — set by whoever
/// creates the code, not a fixed list. Redeemable only through the public web
/// registration form.
model VoucherCode {
  id          String         @id @default(cuid())
  eventId     String
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code        String         @unique
  badgeTier   String
  maxUses     Int            @default(1)
  /// Atomically incremented via a compare-and-swap update on redemption, same
  /// pattern as MerchItem.soldCount, so a limited-use code can't be
  /// double-redeemed by two people at once.
  usedCount   Int            @default(0)
  createdAt   DateTime       @default(now())

  redemptions Registration[]

  @@index([eventId])
}

/// Single-use sign-in codes handed out by the bot. This is how someone signs
/// in when the Login Widget is unavailable — on localhost, on plain HTTP, or
/// before /setdomain has been configured.
model LoginCode {
  code       String   @id
  telegramId String
  createdAt  DateTime @default(now())
  usedAt     DateTime?

  @@index([telegramId])
}

/// Single-use sign-in codes emailed to attendees who don't use Telegram —
/// the only other way an end user signs in, now that end users can't set a
/// password. emailIndex is a blind index (see lib/crypto.js); the email
/// address itself isn't stored here at all, so there's nothing to encrypt.
model EmailLoginCode {
  code       String   @id
  emailIndex String
  createdAt  DateTime @default(now())
  usedAt     DateTime?

  @@index([emailIndex])
}

/// Conversation state for the registration bot.
model BotSession {
  telegramId String   @id
  state      String   @default("idle")
  draft      Json     @default("{}")
  updatedAt  DateTime @updatedAt
}

/// Single-row-per-key store for branding and instance settings.
model Setting {
  key   String @id
  value Json
}

model Ban {
  id               String   @id @default(cuid())
  legalName        String?
  email            String?
  telegramId       String?
  telegramUsername String?
  reason           String   @default("")
  createdById      String?
  createdBy        User?    @relation("BansCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([legalName])
  @@index([email])
  @@index([telegramId])
  @@index([telegramUsername])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
}
